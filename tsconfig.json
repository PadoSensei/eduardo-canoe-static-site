{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler", // TS 5.0+ standard
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    // SENIOR MOVE: Remove explicit "types" if vite-env.d.ts is present.
    // TS will find them via the "include" and the triple-slash reference.
    "types": []
  },
  "include": ["src", "src/**/*.d.ts"], // Explicitly include definition files
  "exclude": ["node_modules", "dist"]
}
